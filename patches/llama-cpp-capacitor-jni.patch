                 }
-                
-                ctx->completion->loadPrompt({});
+
+                // [bm-bids patch] Pass images to the model. media_paths_json is a JSON array of file paths; each one
+                // fills a <__media__> marker in the prompt. This used to be loadPrompt({}), which dropped all images.
+                std::vector<std::string> media_paths;
+                std::string media_json = jni_utils::jsobject_opt_string(env, params, "media_paths_json", "");
