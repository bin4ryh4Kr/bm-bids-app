+// [bm-bids patch] How many cores are "fast": those whose top speed is at least 70% of the fastest core's.
+// Phones mix fast and slow cores; running math on the slow ones makes everything wait for them.
+static int bm_fast_core_count() {
+    std::vector<long> freqs;
+    for (int i = 0; i < 64; i++) {
+        std::ifstream f("/sys/devices/system/cpu/cpu" + std::to_string(i) + "/cpufreq/cpuinfo_max_freq");
+        long v = 0;
+        if (!(f >> v)) break;
+        freqs.push_back(v);
+    }
+    if (freqs.empty()) {
+        unsigned int n = std::thread::hardware_concurrency();
+        return n > 4 ? (int)n - 2 : (n > 1 ? (int)n : 2);
+    }
+    long top = 0;
+    for (long v : freqs) if (v > top) top = v;
+    int fast = 0;
+    for (long v : freqs) if (v * 10 >= top * 7) fast++;
+    if (fast < 2) fast = 2;
+    if (fast > 8) fast = 8;
+    return fast;
+}
 
